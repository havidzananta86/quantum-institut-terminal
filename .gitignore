# API keys & config (JANGAN push ke public repo!)
config/api_keys.php
config/database.php
config/bridge.php

# Cache = runtime state. Everything in it is ignored, including secrets the
# app writes there itself: telegram.json (bot token), notify_secret.json
# (webhook encryption key), tv_webhook_secret.txt, referrals.json, api_keys.json.
# calendar.json and news.json are still tracked as a cold-start fallback.
cache/*
!cache/.gitkeep
!cache/calendar.json
!cache/news.json

# Uploads
uploads/avatars/*
!uploads/avatars/.gitkeep

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Node
node_modules/
# package-lock.json is deliberately NOT ignored. This is an application,
# not a library: committing the lockfile is what makes `npm ci` install
# the same tailwindcss build locally and in CI. Without it the generated
# tailwind.css can drift between machines, which is how utility classes
# went missing from the prebuilt stylesheet before.

# Logs
*.log

.vercel
cache/chart/
cache/ratelimit/
cache/logs/
cache/csp-reports/
cache/frankfurter/
cache/tv-scan/
cache/errorlogs/

# Claude Code local session config
.claude/

# Stray copies of top-level folders (api.3155/, config.5493/, .claude.8513/ ...)
# left behind by an interrupted copy/rename. config.5493/ holds real credentials.
/*.[0-9][0-9][0-9][0-9]/

# Per-account EA downloads (qi-<id>/, qi-exec-<id>/) have a live bridge key
# baked in. The tracked templates live in assets/mt-bridge/.
/qi-*/
qim-vps-bundle.zip
deploy/caddy_*.zip
deploy/caddy_*_checksums.txt

# Rahasia bridge. Sebelumnya tv-bridge/.env TIDAK terabaikan — satu `git add -A`
# cukup untuk mendorongnya ke repo publik yang langsung ter-deploy.
.env
*.env
.env.*

# quantum-terminal/ = widget chart vendor (TradeCanvas) untuk iframe terminal. Mirror situs vendor LENGKAP (~83 MB: docs
# 15 bahasa, ribuan chunk dari build lama) tidak boleh masuk repo; yang disimpan hanya berkas yang terjangkau dari
# embed/index.html (±220 berkas, ±5 MB) beserta tambalannya — lihat quantum-terminal/CATATAN-VENDOR.md. Tanpa folder ini
# dashboard di server kosong (git adalah jalur deploy-nya). Jangan menyalin mirror utuh kembali ke sini.
