# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Node
node_modules/
# package-lock.json is deliberately NOT ignored. This is an application,
# not a library: committing the lockfile is what makes `npm ci` install
# the same tailwindcss build locally and in CI. Without it the generated
# tailwind.css can drift between machines, which is how utility classes
# went missing from the prebuilt stylesheet before.

# Logs
*.log

.vercel
cache/chart/
cache/ratelimit/
cache/logs/
cache/csp-reports/
cache/frankfurter/
cache/tv-scan/
cache/errorlogs/

