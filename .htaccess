# Quantum Institut Server Configuration — Hardened Security
RewriteEngine On
RewriteBase /

# Teruskan header Authorization ke PHP (Apache mod_php sering stripping ini).
# Tanpa ini, token Bearer tidak sampai ke $_SERVER dan auth gagal.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# =============================================
# PROTEKSI AKSES FOLDER & FILE SENSITIF
# Blokir akses langsung ke folder internal
# =============================================
Options -Indexes

# Blokir folder sensitif: config, engine, database, cache, scratch, .vercel
RewriteRule ^(config|engine|database|cache|scratch|\.vercel)/ - [F,L]

# Blokir file sensitif langsung
RewriteRule \.sql$ - [F,L]
RewriteRule \.env$ - [F,L]
RewriteRule \.log$ - [F,L]
RewriteRule \.bak$ - [F,L]

# =============================================
# SECURITY HEADERS (LENGKAP)
# =============================================
<IfModule mod_headers.c>
    # Cegah MIME sniffing
    Header set X-Content-Type-Options "nosniff"

    # Cegah clickjacking — hanya izinkan dari domain sendiri
    Header set X-Frame-Options "SAMEORIGIN"

    # XSS Protection fallback untuk browser lama
    Header set X-XSS-Protection "1; mode=block"

    # HSTS — paksa HTTPS selama 1 tahun + subdomains
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Referrer Policy — kirim origin saja saat cross-origin
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy — nonaktifkan fitur browser yang tidak dipakai
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Content Security Policy — Enforcing mode
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://s3.tradingview.com https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.binance.com https://api1.binance.com https://api2.binance.com https://api3.binance.com https://data-api.binance.vision https://api.binance.us https://fapi.binance.com wss://stream.binance.com:9443 wss://stream.binance.vision https://xaus.com https://nfs.faireconomy.media https://*.vercel.app https://api.twelvedata.com https://biquote.io https://accounts.google.com https://api.alternative.me https://api.frankfurter.app https://api.coingecko.com; frame-src https://s3.tradingview.com https://*.tradingview.com https://www.tradingview-widget.com https://accounts.google.com; report-uri /api/csp-report.php;"
</IfModule>

# =============================================
# CACHE CONTROL — Aset statis immutable
# =============================================
<IfModule mod_expires.c>
    ExpiresActive On
    # Fonts — jarang berubah
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff  "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    # CSS & JS
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    # Images
    ExpiresByType image/png  "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType image/x-icon "access plus 1 year"
    # JSON cache files — pendek
    ExpiresByType application/json "access plus 5 minutes"
    # HTML — jangan cache lama
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
    # Fonts — immutable, 1 year (rarely change)
    <FilesMatch "\.(woff2?|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # CSS/JS/Images — immutable, 30 days with stale-while-revalidate
    <FilesMatch "\.(css|js|png|jpe?g|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400, immutable"
    </FilesMatch>
    # HTML dan PHP — no-cache (selalu fresh)
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# =============================================
# BROTLI COMPRESSION (preferred, falls back to deflate)
# =============================================
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json text/xml image/svg+xml application/xml
    BrotliCompressionQuality 6
</IfModule>

# =============================================
# GZIP / DEFLATE COMPRESSION (fallback)
# =============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/xml image/svg+xml application/xml
</IfModule>

# Custom 404 — PHP wrapper ensures correct 404 status in any subdirectory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpe?g|gif|ico|svg|woff2?|map|json|webp|xml|txt|webmanifest)$ [NC]
RewriteRule ^ 404.php [L]
ErrorDocument 404 /404.php
