{
  "name": "quantum-institut-terminal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i assets/css/tailwind-input.css -o assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i assets/css/tailwind-input.css -o assets/css/tailwind.css --watch",
    "test": "npm run test:php && npm run test:unit",
    "test:php": "node tests/php-syntax.test.js",
    "test:unit": "node tests/correlation.test.js",
    "test:smoke": "node tests/api-smoke.test.js"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
