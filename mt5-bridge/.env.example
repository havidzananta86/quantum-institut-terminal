# Copy to .env (never commit .env). Values here are placeholders.

# Same value as QI_MT5_BRIDGE_SECRET in config/api_keys.php (PHP). >= 32 chars.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BRIDGE_JWT_SECRET=

# Dashboard origin(s) allowed to open the WebSocket, comma-separated.
ALLOWED_ORIGINS=https://quantum-institut.com

# dashboardCode:brokerSymbol pairs. Brokers often add suffixes (XAUUSD.m, EURUSD.pro, BTCUSD#).
SYMBOLS=XAUUSD:XAUUSD,EURUSD:EURUSD,BTCUSDT:BTCUSD

# production | development (development enables /docs and allows MT5_MOCK)
BRIDGE_ENV=production
MT5_MOCK=0

# Optional: leave empty to attach to the terminal that is already logged in.
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Broker server time minus UTC, in hours (e.g. 3 for many GMT+3 brokers). Fixes candle times.
BROKER_TZ_OFFSET_H=0

POLL_MS=100
THROTTLE_MS=100
STALE_AFTER_S=10
MAX_CLIENTS=200
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
